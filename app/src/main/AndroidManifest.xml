<?xml version="1.0" encoding="utf-8"?>
<!-- 包名由 Gradle 的 namespace/applicationId 提供（com.ti.tasktimer，与旧版一致，可覆盖安装） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Supabase 同步（v1.7.0）：HTTPS 接口 + Realtime WebSocket -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 屏幕内容守卫：MediaProjection 采集前台服务类型（安卓 14+ 必须声明） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 关键：持有此权限是官方认可的后台启动页面豁免之一，亮屏时可直接弹出全屏页，不必经通知 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- 安卓 11+ 包可见性：不声明就只能看到极少数应用（选择器里只剩商店/云端硬盘/设置）。
         本应用需要列出全部可启动应用供用户给任务挑软件（专注规则、主软件、Muse 应用）。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".KnowDoApp"
        android:label="知行 KnowDo"
        android:icon="@android:drawable/ic_lock_idle_alarm"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PermActivity"
            android:exported="false" />

        <activity
            android:name=".LogActivity"
            android:exported="false" />

        <activity
            android:name=".HelpActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".CalendarActivity"
            android:exported="false" />

        <!-- 屏幕内容守卫采集服务：计时期间随机采样屏幕（MediaProjection，仅本机分析） -->
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 实时同步服务：桥模式每 30 秒轮询 Drive 桥文件；Supabase 模式走 Realtime 推送 + 30 秒对账；
             有新任务自动合并、带立即开始标记的自动开始计时，计时状态跨设备镜像 -->
        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="与云端任务清单同步（桥文件轮询或 Supabase 实时推送），发现立即开始标记时自动启动任务倒计时，计时状态跨设备同步" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".CurrentTaskActivity"
            android:exported="false" />

        <!-- 专注守卫问询页：与全屏检查页同样的展示属性 -->
        <activity
            android:name=".GuardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- 全屏检查页：压锁屏显示、点亮屏幕、独立任务、不进最近任务 -->
        <activity
            android:name=".CheckActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name=".TimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Task countdown timer that alerts the user at half-time and at completion" />
        </service>

        <receiver
            android:name=".AlertReceiver"
            android:exported="false" />

        <!-- 常驻悬浮窗服务：打开过知行后一直维持悬浮窗（当前第一要务） -->
        <service
            android:name=".FloatService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="常驻悬浮窗：显示当前第一要务，可直接开始、暂停与记录" />
        </service>

        <!-- 暂停提醒：到点叫回继续任务 -->
        <receiver
            android:name=".ResumeReceiver"
            android:exported="false" />

        <!-- 暂停叫回 60 秒无反馈：渐强闹铃升级（v1.11.0） -->
        <receiver
            android:name=".PauseEscalationReceiver"
            android:exported="false" />

        <!-- 静音暂停：每 5 分钟亮屏提醒链（v1.11.0） -->
        <receiver
            android:name=".SilentNudgeReceiver"
            android:exported="false" />

        <activity
            android:name=".ResumeRemindActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- 「下一个任务」全屏页（任务衔接守卫 v1.10.0）：空档时全屏问下一个 -->
        <activity
            android:name=".NextTaskActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- 开始提醒：任务的下次开始时间到点，全屏叫用户开始 -->
        <receiver
            android:name=".StartReceiver"
            android:exported="false" />

        <activity
            android:name=".StartRemindActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- 任务闹钟（v1.9.0）：到点由接收器拉起响铃页，展示属性与开始提醒页一致 -->
        <receiver
            android:name=".TaskAlarmReceiver"
            android:exported="false" />

        <activity
            android:name=".TaskAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- AI 按钮中转页：复制任务信息到剪贴板并打开设定的 AI 助手 -->
        <activity
            android:name=".AiLaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 空档催促闹钟接收器（v1.14.0） -->
        <receiver
            android:name=".IdleAlarmReceiver"
            android:exported="false" />

        <!-- 悬浮窗「关闭」选择页（v1.14.0）：半透明中转页 -->
        <activity
            android:name=".FloatCloseActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 晨间页（v1.16.0；v1.17.0 起三种模式＋首触全屏）：晨间首填开启后每天先到
             这里，填完才开启今天；不进最近任务。showWhenLocked/turnScreenOn 与其他
             全屏页同款，供锁屏 FullScreenIntent 路径直接呈现 -->
        <activity
            android:name=".MorningActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 习惯提醒接收器（v1.16.0）：每习惯独立提醒时间到点发通知 -->
        <receiver
            android:name=".HabitReceiver"
            android:exported="false" />

        <!-- 晨间页「暂停一会儿」到点接收器（v1.17.0）：推后时刻到，再次全屏拉起晨间页 -->
        <receiver
            android:name=".MorningReceiver"
            android:exported="false" />

        <!-- 空档催促全屏页（v1.19.0）：一轮 staging 一页（震→响）＋底部路人静音大按钮；
             展示属性与守卫页同款（压锁屏、点亮屏幕、独立任务） -->
        <activity
            android:name=".IdleAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- 致谢页（v1.19.0）：路人静音后机主下次解锁先见，展示属性同款 -->
        <activity
            android:name=".ThanksActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- 建议设置清单（v1.19.0）：五项系统开关逐项检测＋跳转，普通设置页 -->
        <activity
            android:name=".SuggestedSettingsActivity"
            android:exported="false" />
    </application>
</manifest>
